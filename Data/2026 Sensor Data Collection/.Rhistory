mutate(datetime = as_datetime(datetime_orig, tz="America/New_York")) %>%
mutate(week = week(date)) %>%
filter(week>=26 & week<=46)
# Basic DID
did_data <- prelim_data %>%
mutate(post = case_when(datetime < make_datetime(year = year(treatment_date),
month = month(treatment_date),
day = day(treatment_date),
hour = 0,
min = 0,
sec = 0,
tz = "America/New_York") ~ 0,
datetime >= make_datetime(year = year(treatment_date),
month = month(treatment_date),
day = day(treatment_date)+2, # exclude day of treatment and day after
hour = 0,
min = 0,
sec = 0,
tz = "America/New_York") ~ 1,
TRUE ~ NA)) %>%
filter(!is.na(post)) %>%
mutate(treat_post = treat_25*post) %>%
# Make the pre-period more comparable, starting in August
# filter(week>=30 & week<=44) %>%
# Try 1.5 month before and after treatment date
filter((date>=treatment_date-days(61)) & (date<=treatment_date+days(60))) %>%
mutate(date = as.Date(date),
treatment_date = as.Date(treatment_date)) %>%
mutate(time_unit = week - treatment_week)
names(did_data)
basic_did4 <- lm(Temperature ~ treat_25 + post + treat_post + AvgTemperature + factor(hour) + Shade + COR_WIDTH + sensor_direction, # + treat_25:post
data=did_data)
summary(basic_did4)
basic_did3 <- lm(Temperature ~ treat_25 + post + treat_post + AvgTemperature + factor(hour), # + treat_25:post
data=did_data)
summary(basic_did3)
basic_did4 <- lm(Temperature ~ treat_25 + post + treat_post + AvgTemperature + factor(hour) + Shade + COR_WIDTH + sensor_direction, # + treat_25:post
data=did_data)
summary(basic_did4)
# LOOP THROUGH EACH HOUR AND ESTIMATE IMPACT
hours_sequence <- seq(from=0, to=23)
results_df <- data.frame()
for (h in hours_sequence) {
model_name <- paste("did_hour_",h,sep="")
model <- lm(Temperature ~ treat_25 + post + treat_post + AvgTemperature + Shade + week + COR_WIDTH + sensor_direction, # + treat_25:post
data=did_data[did_data$hour==h,])
# hourly_models[[model_name]] <- model
# Extract coefficients & CIs
coeffs_i <- coef(model)
ci_i <- confint(model)
# Combine into a data frame row
row_data <- data.frame(
Hour = h,
Term = names(coeffs_i),
Estimate = coeffs_i,
CI_2.5 = ci_i[, 1],
CI_97.5 = ci_i[, 2]
)
results_df <- rbind(results_df, row_data)
}
hourly_results <- results_df %>%
filter(Term=="treat_post")
ggplot(hourly_results, aes(x = Hour, y = Estimate)) +
geom_point(size = 3, color = "blue") + # Plot the central value
geom_errorbar(aes(ymin = CI_2.5, ymax = CI_97.5), width = 0.2, color = "red") + # Plot the 95% CI
labs(title = "Value with 95% Confidence Intervals",
x = "Hour",
y = "Estimate") +
theme_minimal() +
geom_hline(yintercept = 0, # Convert datetime to numeric
color = "black",
linetype = "dashed",
size = 1) +
xlim(0,23) +
scale_x_continuous(breaks = 0:23)
